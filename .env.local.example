# Supabase Auth: copy these values from Project Settings > API Keys.
# The publishable key is intentionally used for user authentication; never put
# SUPABASE_SECRET_KEY in this local browser-facing configuration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ORIGIN=http://127.0.0.1:53128
AUTH_RECOVERY_SECRET=replace_with_a_long_random_value
