{
  "name": "english-companions",
  "version": "0.1.0",
  "description": "A local-first web app for creating multiple AI language companion agents with chat, per-companion practice language, select-to-translate, a word book, lightweight memory, emotional support, and scheduled daily content picks.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/3293578/Intelligent-companions.git"
  },
  "keywords": [
    "language-learning",
    "english-learning",
    "ai-companion",
    "agent",
    "translation",
    "daily-content",
    "local-first"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node server.mjs",
    "preview": "powershell -ExecutionPolicy Bypass -File scripts/preview.ps1",
    "open": "powershell -ExecutionPolicy Bypass -File scripts/start-wyth.ps1"
  }
}
